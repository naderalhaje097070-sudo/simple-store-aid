# Environment template — copy to .env and fill with your own values.
# NEVER commit real/live values. Only placeholders belong in this file.

# --- Supabase (client, browser-exposed via VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-side only — never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key is a SECRET. Set it only in the server environment
# (Vercel/Lovable env vars), never in a committed file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (client token, browser-exposed via VITE_) ---
VITE_PAYMENTS_CLIENT_TOKEN=
