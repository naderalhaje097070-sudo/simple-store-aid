# Environment template — copy to .env and fill with your own values.
# NEVER commit real/live values. Only placeholders belong in this file.

# --- Deployment intent (build/server only; never expose as VITE_) ---
# Allowed: local | ci | preview | staging | production
# Endpoint contract:
#   local/ci       -> http loopback Supabase only
#   preview/staging -> https://<project-id>.supabase.co for a dedicated non-production project
#   production      -> the explicitly approved production project only
# Custom gateways, URL credentials, query/fragment routing, and path prefixes are rejected.
MONGEZZ_DEPLOY_TARGET=

# Write-capable E2E safety marker.
# Do NOT persist as 1 in shared/hosted environments. The rapid-click harness
# additionally requires local|ci plus loopback Supabase/Postgres targets.
MONGEZZ_E2E_WRITE_TEST=0

# --- Supabase (client, browser-exposed via VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-side aliases — never prefix secrets with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Service role key is a SECRET. Set it only in the server environment
# (Vercel/Lovable env vars), never in a committed file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (client token, browser-exposed via VITE_) ---
VITE_PAYMENTS_CLIENT_TOKEN=
